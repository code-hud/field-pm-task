# Copy to `.env` and fill in your New Relic license key. Everything else has a working
# default, so this file is really only about the OTEL_ lines.
#
#   cp .env.example .env

# ---- New Relic (required to see traces + metrics) ---------------------------
# Sign up free at https://newrelic.com (Gmail works), then:
#   Account → API keys → create/copy your INGEST - LICENSE key (40 chars).
# US region (default). For the EU account: https://otlp.eu01.nr-data.net
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# Your license key goes in the api-key header.
OTEL_EXPORTER_OTLP_HEADERS=api-key=<your-new-relic-license-key>
# Leave these as-is (New Relic wants protobuf + delta metric temporality).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ---- ports (change only if something local already uses them) ---------------
WEB_PORT=8080
API_PORT=4000
FRAUD_PORT=4100
POSTGRES_PORT=5432

# ---- traffic (optional) ------------------------------------------------------
# Virtual users the load generator drives. More users = more traffic.
LOADGEN_USERS=12
# Flat arrival rate instead of the Eastern-time session curve.
# LOADGEN_DAY_SHAPE=false
