# Copy to `.env` only if you want to change a default — the stack runs without it.
#
#   cp .env.example .env
#
# Traces go to a local Jaeger that starts with the stack (http://localhost:16686).
# No account, no key.

# ---- ports (change only if something local already uses them) ---------------
WEB_PORT=8080
API_PORT=4000
FRAUD_PORT=4100
POSTGRES_PORT=5432
JAEGER_UI_PORT=16686

# ---- traffic (optional) ------------------------------------------------------
LOADGEN_USERS=12
# LOADGEN_DAY_SHAPE=false
