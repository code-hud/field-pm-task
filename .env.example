# Copy to `.env` and fill in your SigNoz Cloud details. Everything else has a working
# default, so this file is really only about the two OTEL_ lines.
#
#   cp .env.example .env

# ---- SigNoz Cloud (required to see traces + metrics) -------------------------
# From your SigNoz Cloud account: Settings → Ingestion. The endpoint is region-specific.
#   e.g. https://ingest.us.signoz.cloud:443  (or eu / in — match your account's region)
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
# Your ingestion key, as a header. Keep the `signoz-access-token=` prefix.
OTEL_EXPORTER_OTLP_HEADERS=signoz-access-token=<your-ingestion-key>
# Leave this as-is unless you know you need grpc.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ---- ports (change only if something local already uses them) ---------------
WEB_PORT=8080
API_PORT=4000
FRAUD_PORT=4100
POSTGRES_PORT=5432

# ---- traffic (optional) ------------------------------------------------------
# Virtual users the load generator drives. More users = more traffic.
LOADGEN_USERS=12
# Flat arrival rate instead of the Eastern-time session curve.
# LOADGEN_DAY_SHAPE=false
