# Copy to `.env` and fill in your Honeycomb API key. Everything else has a working
# default, so this file is really only about the OTEL_ lines.
#
#   cp .env.example .env

# ---- Honeycomb (required to see traces + metrics) ---------------------------
# Sign up free at https://www.honeycomb.io (Gmail works), then:
#   Account → API Keys → create an ingest key.
# US region (default). For the EU: https://api.eu1.honeycomb.io
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# Your ingest key goes in the x-honeycomb-team header. The dataset header names where
# metrics land (traces are grouped by service automatically, so it's ignored for them).
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<your-api-key>,x-honeycomb-dataset=field-pm-task
# Leave this as-is.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ---- ports (change only if something local already uses them) ---------------
WEB_PORT=8080
API_PORT=4000
FRAUD_PORT=4100
POSTGRES_PORT=5432

# ---- traffic (optional) ------------------------------------------------------
# Virtual users the load generator drives. More users = more traffic.
LOADGEN_USERS=12
# Flat arrival rate instead of the Eastern-time session curve.
# LOADGEN_DAY_SHAPE=false
