# Copy to `.env` only if you want to change a default — the stack runs without it.
#
#   cp .env.example .env
#
# Traces go to a local Jaeger that starts with the stack (http://localhost:16686).
# There is no account and no key to set up.

# ---- ports (change only if something local already uses them) ---------------
WEB_PORT=8080
API_PORT=4000
FRAUD_PORT=4100
POSTGRES_PORT=5432
JAEGER_UI_PORT=16686

# ---- traffic (optional) ------------------------------------------------------
# Virtual users the load generator drives. More users = more traffic.
LOADGEN_USERS=12
# Flat arrival rate instead of the Eastern-time session curve.
# LOADGEN_DAY_SHAPE=false

# ---- point at a different OTLP backend instead of local Jaeger (optional) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-endpoint:443
