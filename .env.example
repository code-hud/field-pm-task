# Copy to `.env` only if you want to change a default — the stack runs without it.
#
#   cp .env.example .env
#
# Traces always go to a local Jaeger that starts with the stack (http://localhost:16686) —
# no account, no key. Optionally, they can ALSO go to Honeycomb (see below).

# ---- Honeycomb (optional second backend) ------------------------------------
# Leave empty to use Jaeger only. To also send traces to Honeycomb:
#   1. Sign up free at https://www.honeycomb.io (a Gmail address works)
#   2. Create an ingest key (Account -> API Keys)
#   3. Paste it here and restart:  docker compose up -d
# HONEYCOMB_API_KEY=your-honeycomb-ingest-key
# For an EU account: HONEYCOMB_OTLP_ENDPOINT=https://api.eu1.honeycomb.io

# ---- ports (change only if something local already uses them) ---------------
WEB_PORT=8080
API_PORT=4000
FRAUD_PORT=4100
POSTGRES_PORT=5432
JAEGER_UI_PORT=16686

# ---- traffic (optional) ------------------------------------------------------
LOADGEN_USERS=12
# LOADGEN_DAY_SHAPE=false
